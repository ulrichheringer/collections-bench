<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:vm="using:CollectionsBench.ViewModels" mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="650" x:Class="CollectionsBench.Views.MainView" x:DataType="vm:MainViewModel">
  <ScrollViewer><StackPanel Margin="28" Spacing="18" MaxWidth="820" HorizontalAlignment="Center">
    <TextBlock Text="Collections Bench" FontSize="30" FontWeight="Bold"/><TextBlock Text="Compare buscas em array, List, HashSet e array ordenado." Opacity="0.75"/><Button Content="Executar benchmark" Command="{Binding RunBenchmarksCommand}" HorizontalAlignment="Left"/>
    <Border Padding="16" CornerRadius="8" Background="#F1F5F9"><StackPanel Spacing="10"><Grid ColumnDefinitions="3*,*,*"><TextBlock Text="Estrutura / algoritmo" FontWeight="Bold"/><TextBlock Grid.Column="1" Text="Mediana (ms)" FontWeight="Bold"/><TextBlock Grid.Column="2" Text="Encontrados" FontWeight="Bold"/></Grid><ItemsControl ItemsSource="{Binding Results}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="3*,*,*" Margin="0,6"><TextBlock Text="{Binding Collection}"/><TextBlock Grid.Column="1" Text="{Binding MedianMilliseconds, StringFormat='{}{0:F3}'}"/><TextBlock Grid.Column="2" Text="{Binding FoundCount}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
    <TextBlock Text="{Binding Summary}" TextWrapping="Wrap"/>
  </StackPanel></ScrollViewer>
</UserControl>
